{
  "name": "{{ server_name }}",
  "version": "{{ server_version }}",
  "description": "MCP server generated from OpenAPI specification",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc -w & nodemon build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi"
  ],
  "author": "Generated by openapi-to-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    {%- if runtime_validation == 'input' %}
    "ajv": "^8.20.0",
    {%- endif %}
    "axios": "^1.19.0",
    "dotenv": "^17.4.2"{% if transport == 'streamable-http' %},
    "express": "^5.2.1"
    {% endif %}
  },
  "devDependencies": {
    {% if transport == 'streamable-http' %}"@types/express": "^5.0.6",
    {% endif %}
    "@types/node": "^22.20.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
