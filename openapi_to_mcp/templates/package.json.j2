{
  "name": "{{ server_name }}",
  "version": "{{ server_version }}",
  "description": "MCP server generated from OpenAPI specification",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc -w & nodemon build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi"
  ],
  "author": "Generated by openapi-to-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22{% if telemetry == 'opentelemetry' %}.15.0{% endif %}"
  },
  "dependencies": {
    {% if transport == 'streamable-http' %}"@modelcontextprotocol/node": "^2.1.2",
    {% endif %}"@modelcontextprotocol/server": "^2.4.0",
    {%- if runtime_validation == 'input' %}
    "ajv": "^8.20.0",
    {%- endif %}
    {% if telemetry == 'opentelemetry' %}"@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    {% endif %}    "axios": "^1.20.0",
    "dotenv": "^18.0.1"{% if transport == 'streamable-http' %},
    "express": "^5.2.1"
    {% endif %}
  },
  "devDependencies": {
    {% if transport == 'streamable-http' %}"@types/express": "^5.0.6",
    {% endif %}
    "@types/node": "^22.20.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}
