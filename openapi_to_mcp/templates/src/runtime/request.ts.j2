import axios, { type AxiosInstance } from 'axios';

import { resolveAuthForTool } from './auth.js';
import { MAX_RESPONSE_BYTES, TARGET_API_AUTH_HEADER, TARGET_API_BASE_URL, TOOL_TIMEOUT_MS } from './config.js';
import { admitResponseBody, resolveResponseByteLimit } from './response_body.js';
import { createToolExecutionError, throwIfCancelled } from './errors.js';
import { componentEscape, serializeForm, serializeWholeJson } from './form_media.js';
import type { ToolRuntimeMetadata } from './generated.js';
import {
  replaceSafeQueryEntries,
  serializeQueryEntries,
  type QueryEntry,
} from './query.js';
import { applyCookieParam, applyQueryParam, serializeHeaderValue, serializePathValue } from './serialization.js';

export interface RequestContext {
  cookies: Record<string, string>;
  headers: Record<string, string>;
  queryEntries: QueryEntry[];
  queryParams: Record<string, unknown>;
  requestData: unknown;
  sensitiveCookieNames: string[];
  sensitiveQueryNames: string[];
  wholeQuery: string | null;
  wholeQueryNames: string[];
  wholeQueryType: string | null;
  wireData: unknown;
  targetPath: string;
}

export interface UpstreamResponse {
  cacheHit?: boolean;
  contentType: unknown;
  errorCode?: string;
  errorSource?: string;
  responseData: unknown;
  status: number | null;
}

export function isSafeMethod(method: string): boolean {
  return method === 'GET' || method === 'HEAD' || method === 'OPTIONS';
}

export function buildRequestContext(
  tool: ToolRuntimeMetadata,
  args: Record<string, unknown>,
  requestId: string
): RequestContext {
  const requestContext = applyParameterValues(tool, args);
  requestContext.headers['X-Request-Id'] = requestId;
  const authNames = applyAuthContext(
    tool,
    requestContext.headers,
    requestContext.queryEntries,
    requestContext.queryParams,
    requestContext.cookies,
    requestContext.wholeQueryType,
    requestContext.wholeQueryNames
  );
  requestContext.sensitiveCookieNames = authNames.cookies;
  requestContext.sensitiveQueryNames = authNames.query;
  applyDefaultAuthHeader(requestContext.headers);
  applyCookieHeader(requestContext.headers, requestContext.cookies);
  requestContext.requestData = applyRequestBody(tool, args, requestContext.headers);
  requestContext.wireData = requestContext.requestData;
  if (tool.requestBody?.form && requestContext.requestData !== undefined) {
    requestContext.wireData = serializeForm(requestContext.requestData, tool.requestBody.form).wire;
  }
  return requestContext;
}

export async function executeHttpRequest(
  axiosInstance: AxiosInstance,
  tool: ToolRuntimeMetadata,
  requestContext: RequestContext,
  signal?: AbortSignal
): Promise<UpstreamResponse> {
  throwIfCancelled(signal);
  const timeoutMs = tool.execution?.timeoutMs ?? TOOL_TIMEOUT_MS;
  const abortController = new AbortController();
  let abortCause: 'caller' | 'timeout' | undefined;
  const onAbort = () => {
    if (!abortCause) {
      abortCause = 'caller';
      abortController.abort();
    }
  };
  signal?.addEventListener('abort', onAbort, { once: true });
  if (signal?.aborted) onAbort();
  const timeoutHandle = setTimeout(() => {
    if (!abortCause) {
      abortCause = 'timeout';
      abortController.abort(new Error('Tool execution timeout exceeded'));
    }
  }, timeoutMs);

  let adapterFailed = false;
  let adapterFailure: unknown;
  try {
    const adapter = axios.getAdapter(axiosInstance.defaults.adapter);
    const limit = resolveResponseByteLimit(MAX_RESPONSE_BYTES, tool.execution?.maxResponseBytes);
    const response = await axiosInstance.request({
      method: tool.method,
      url: requestContext.targetPath,
      params: requestContext.wholeQueryType ? { whole: true } : requestContext.queryParams,
      paramsSerializer: {
        serialize: () => requestContext.wholeQueryType ? [requestContext.wholeQuery, serializeQueryEntries(requestContext.queryEntries)].filter(Boolean).join('&') : serializeQueryEntries(requestContext.queryEntries),
      },
      headers: requestContext.headers,
      data: requestContext.wireData,
      signal: abortController.signal,
      adapter: (config) => adapter(config).catch((error: unknown) => {
        // Axios may replace an adapter failure with cancellation during dispatch.
        // Retain the raw outcome when it is not itself a cancellation.
        if (!axios.isCancel(error)) {
          adapterFailed = true;
          adapterFailure = error;
        }
        throw error;
      }),
      validateStatus: limit > 0 ? () => true : (status) => status >= 200 && status < 300,
      ...(limit > 0 ? { responseType: 'stream' as const, transformResponse: [(data: unknown) => data] } : {}),
    });
    const admitted = limit > 0 ? await admitResponseBody(response, limit, axiosInstance) : response;
    return {
      responseData: admitted.data,
      contentType: admitted.headers['content-type'],
      status: admitted.status,
    };
  } catch (error) {
    // Preserve an already determined upstream error; only classify abort errors
    // using the first signal that interrupted this request.
    if (axios.isCancel(error)) {
      if (adapterFailed) throw adapterFailure;
      if (abortCause === 'caller') {
        throw createToolExecutionError('request_cancelled', 'runtime', false, 'Tool execution cancelled');
      }
      if (abortCause === 'timeout') {
        throw createToolExecutionError('tool_timeout', 'runtime', true, 'API request cancelled or timed out');
      }
    }
    throw error;
  } finally {
    clearTimeout(timeoutHandle);
    signal?.removeEventListener('abort', onAbort);
  }
}

function applyParameterValues(
  tool: ToolRuntimeMetadata,
  args: Record<string, unknown>
): RequestContext {
  let targetPath = tool.path;
  const queryEntries: QueryEntry[] = [];
  const queryParams: Record<string, unknown> = Object.create(null);
  const headers: Record<string, string> = { Accept: 'application/json' };
  const cookies: Record<string, string> = {};
  let wholeQuery: string | null = null;
  let wholeQueryNames: string[] = [];
  let wholeQueryType: string | null = null;

  for (const parameter of tool.parameters || []) {
    const paramValue = args[parameter.name];
    if (parameter.in === 'querystring') {
      wholeQueryType = parameter.content_type ?? null;
      if (/[?#]/.test(TARGET_API_BASE_URL) || /[?#]/.test(targetPath)) {
        throw createToolExecutionError('whole_query_url_conflict', 'validation', false, 'Whole-query operations cannot use a base or target URL with a query or fragment.');
      }
    }
    if (paramValue === undefined || paramValue === null) {
      if (parameter.required) {
        throw createToolExecutionError('missing_required_parameter', 'validation', false, `Missing required parameter: ${parameter.name}`);
      }
      continue;
    }
    if (parameter.in === 'querystring') {
      if (parameter.content_type === 'application/x-www-form-urlencoded' && parameter.form) {
        const result = serializeForm(paramValue, parameter.form);
        wholeQuery = result.wire;
        wholeQueryNames = result.names;
      } else if (parameter.content_type === 'application/json') {
        wholeQuery = serializeWholeJson(paramValue);
      } else if (parameter.content_type === 'text/plain' && typeof paramValue === 'string') {
        wholeQuery = componentEscape(paramValue);
      } else {
        throw createToolExecutionError('invalid_whole_query', 'validation', false, 'Unsupported whole-query value.');
      }
      continue;
    }
    if (parameter.in === 'path') {
      targetPath = targetPath.split(`{${parameter.name}}`).join(serializePathValue(parameter, paramValue));
      continue;
    }
    if (parameter.in === 'query') {
      applyQueryParam(queryParams, queryEntries, parameter, paramValue);
      continue;
    }
    if (parameter.in === 'header') {
      headers[parameter.name] = serializeHeaderValue(parameter, paramValue);
      continue;
    }
    if (parameter.in === 'cookie') {
      applyCookieParam(cookies, parameter, paramValue);
    }
  }
  if (wholeQueryType && /[?#]/.test(targetPath)) {
    throw createToolExecutionError('whole_query_url_conflict', 'validation', false, 'Whole-query operations cannot use a base or target URL with a query or fragment.');
  }
  return {
    cookies,
    headers,
    queryEntries,
    queryParams,
    requestData: undefined,
    sensitiveCookieNames: [],
    sensitiveQueryNames: [],
    wholeQuery,
    wholeQueryNames,
    wholeQueryType,
    wireData: undefined,
    targetPath,
  };
}

function applyAuthContext(
  tool: ToolRuntimeMetadata,
  headers: Record<string, string>,
  queryEntries: QueryEntry[],
  queryParams: Record<string, unknown>,
  cookies: Record<string, string>,
  wholeQueryType: string | null,
  wholeQueryNames: string[]
): { cookies: string[]; query: string[] } {
  const resolvedAuth = resolveAuthForTool(tool);
  if (!resolvedAuth.ok) {
    const invalid = resolvedAuth.invalid || [];
    throw createToolExecutionError(
      invalid.length > 0 ? 'invalid_credentials' : 'missing_credentials',
      'auth',
      false,
      invalid.length > 0
        ? `Invalid credentials for required security scheme(s): ${invalid.join(', ')}${resolvedAuth.missing.length > 0 ? `; missing: ${resolvedAuth.missing.join(', ')}` : ''}`
        : `Missing credentials for required security scheme(s): ${resolvedAuth.missing.join(', ')}`
    );
  }
  const queryNames = Object.keys(resolvedAuth.query);
  if (wholeQueryType && queryNames.length && wholeQueryType !== 'application/x-www-form-urlencoded') {
    throw createToolExecutionError('whole_query_auth_conflict', 'auth', false, 'Query credentials cannot be combined with this whole-query media type.');
  }
  if (queryNames.some((name) => wholeQueryNames.includes(name))) {
    throw createToolExecutionError('whole_query_auth_conflict', 'auth', false, 'Query credentials collide with a whole-query form field.');
  }
  Object.assign(headers, resolvedAuth.headers);
  Object.assign(queryParams, resolvedAuth.query);
  replaceSafeQueryEntries(queryEntries, resolvedAuth.query);
  Object.assign(cookies, resolvedAuth.cookies);
  return { cookies: Object.keys(resolvedAuth.cookies), query: queryNames };
}

function applyDefaultAuthHeader(headers: Record<string, string>): void {
  if (!TARGET_API_AUTH_HEADER || Object.keys(headers).some((name) => name.toLowerCase() === 'authorization')) {
    return;
  }
  const separatorIndex = TARGET_API_AUTH_HEADER.indexOf(':');
  if (separatorIndex <= 0) {
    return;
  }
  const headerName = TARGET_API_AUTH_HEADER.substring(0, separatorIndex).trim();
  const headerValue = TARGET_API_AUTH_HEADER.substring(separatorIndex + 1).trim();
  headers[headerName] = headerValue;
}

function applyCookieHeader(
  headers: Record<string, string>,
  cookies: Record<string, string>
): void {
  if (Object.keys(cookies).length === 0) {
    return;
  }
  const cookieHeader = Object.entries(cookies)
    .map(([key, value]) => `${key}=${value}`)
    .join('; ');
  headers.Cookie = headers.Cookie ? `${headers.Cookie}; ${cookieHeader}` : cookieHeader;
}

function applyRequestBody(
  tool: ToolRuntimeMetadata,
  args: Record<string, unknown>,
  headers: Record<string, string>
): unknown {
  const requestBodyInfo = tool.requestBody;
  if (requestBodyInfo && args.requestBody !== undefined && args.requestBody !== null) {
    headers['Content-Type'] = requestBodyInfo.content_type || 'application/json';
    return args.requestBody;
  }
  if (requestBodyInfo?.required) {
    throw createToolExecutionError('missing_required_request_body', 'validation', false, 'Missing required requestBody');
  }
  return undefined;
}
