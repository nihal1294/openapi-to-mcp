import type { CallToolResult } from '@modelcontextprotocol/sdk/types.js';
import axios, { type AxiosInstance } from 'axios';
import * as http from 'http';
import * as https from 'https';
import { MAX_CONCURRENCY, MAX_QUEUE_SIZE, PER_TOOL_MAX_CONCURRENCY, QUEUE_TIMEOUT_MS, TARGET_API_AUTH_HEADER, TARGET_API_BASE_URL, TOOL_TIMEOUT_MS } from './config.js';
import { buildToolErrorResult, createToolExecutionError, mapApiErrorToToolError, ToolExecutionError } from './errors.js';
import type { ToolRuntimeMetadata } from './generated.js';
import { ConcurrencyLimiter } from './limiter.js';
import { createRequestId, logEvent } from './observability.js';
import { buildToolSuccessResult } from './response.js';
import { applyCookieParam, applyQueryParam, serializeHeaderValue, serializePathValue } from './serialization.js';
import { resolveAuthForTool } from './auth.js';
import { validateToolArguments } from './validation.js';

interface RequestContext {
  headers: Record<string, string>;
  queryParams: Record<string, unknown>;
  requestData: unknown;
  targetPath: string;
}
function applyParameterValues(
  tool: ToolRuntimeMetadata,
  args: Record<string, unknown>
): RequestContext {
  let targetPath = tool.path;
  const queryParams: Record<string, unknown> = {};
  const headers: Record<string, string> = { Accept: 'application/json' };
  const cookieValues: Record<string, string> = {};

  for (const parameter of tool.parameters || []) {
    const paramValue = args[parameter.name];
    if (paramValue === undefined || paramValue === null) {
      if (parameter.required) {
        throw createToolExecutionError('missing_required_parameter', 'validation', false, `Missing required parameter: ${parameter.name}`);
      }
      continue;
    }
    if (parameter.in === 'path') {
      targetPath = targetPath.split(`{${parameter.name}}`).join(serializePathValue(parameter, paramValue));
    } else if (parameter.in === 'query') {
      applyQueryParam(queryParams, parameter, paramValue);
    } else if (parameter.in === 'header') {
      headers[parameter.name] = serializeHeaderValue(parameter, paramValue);
    } else if (parameter.in === 'cookie') {
      applyCookieParam(cookieValues, parameter, paramValue);
    }
  }
  if (Object.keys(cookieValues).length > 0) {
    headers.Cookie = Object.entries(cookieValues).map(([key, value]) => `${key}=${value}`).join('; ');
  }
  return { headers, queryParams, requestData: undefined, targetPath };
}
function applyAuthContext(
  tool: ToolRuntimeMetadata,
  headers: Record<string, string>,
  queryParams: Record<string, unknown>
): void {
  const resolvedAuth = resolveAuthForTool(tool);
  if (!resolvedAuth.ok) {
    throw createToolExecutionError(
      'missing_credentials',
      'auth',
      false,
      `Missing credentials for required security scheme(s): ${resolvedAuth.missing.join(', ')}`
    );
  }
  Object.assign(headers, resolvedAuth.headers);
  Object.assign(queryParams, resolvedAuth.query);
  if (Object.keys(resolvedAuth.cookies).length > 0) {
    const cookieHeader = Object.entries(resolvedAuth.cookies)
      .map(([key, value]) => `${key}=${value}`)
      .join('; ');
    headers.Cookie = headers.Cookie ? `${headers.Cookie}; ${cookieHeader}` : cookieHeader;
  }
}
function applyDefaultAuthHeader(headers: Record<string, string>): void {
  if (!TARGET_API_AUTH_HEADER || headers.Authorization) {
    return;
  }
  const separatorIndex = TARGET_API_AUTH_HEADER.indexOf(':');
  if (separatorIndex <= 0) {
    return;
  }
  const headerName = TARGET_API_AUTH_HEADER.substring(0, separatorIndex).trim();
  const headerValue = TARGET_API_AUTH_HEADER.substring(separatorIndex + 1).trim();
  headers[headerName] = headerValue;
}
function applyRequestBody(
  tool: ToolRuntimeMetadata,
  args: Record<string, unknown>,
  headers: Record<string, string>
): unknown {
  const requestBodyInfo = tool.requestBody;
  if (requestBodyInfo && args.requestBody !== undefined && args.requestBody !== null) {
    headers['Content-Type'] = requestBodyInfo.content_type || 'application/json';
    return args.requestBody;
  }
  if (requestBodyInfo?.required) {
    throw createToolExecutionError('missing_required_request_body', 'validation', false, 'Missing required requestBody');
  }
  return undefined;
}
async function executeHttpRequest(
  axiosInstance: AxiosInstance,
  tool: ToolRuntimeMetadata,
  requestContext: RequestContext,
  requestId: string
): Promise<CallToolResult> {
  const timeoutMs = tool.execution?.timeoutMs ?? TOOL_TIMEOUT_MS;
  const abortController = new AbortController();
  const timeoutHandle = setTimeout(() => {
    abortController.abort(new Error('Tool execution timeout exceeded'));
  }, timeoutMs);
  try {
    const response = await axiosInstance.request({
      method: tool.method,
      url: requestContext.targetPath,
      params: requestContext.queryParams,
      headers: requestContext.headers,
      data: requestContext.requestData,
      signal: abortController.signal,
      validateStatus: (status) => status >= 200 && status < 300,
    });
    return buildToolSuccessResult(response.data, response.headers['content-type'], requestId);
  } finally {
    clearTimeout(timeoutHandle);
  }
}
export class ToolExecutor {
  private readonly axiosInstance = axios.create({
    baseURL: TARGET_API_BASE_URL,
    httpAgent: new http.Agent({ keepAlive: true }),
    httpsAgent: new https.Agent({ keepAlive: true }),
  });
  private readonly globalLimiter = new ConcurrencyLimiter(MAX_CONCURRENCY, MAX_QUEUE_SIZE, QUEUE_TIMEOUT_MS);
  private readonly perToolLimiters = new Map<string, ConcurrencyLimiter>();
  private getPerToolLimiter(toolName: string, tool: ToolRuntimeMetadata): ConcurrencyLimiter {
    const existing = this.perToolLimiters.get(toolName);
    if (existing) {
      return existing;
    }
    const maxConcurrency = tool.execution?.maxConcurrency ?? PER_TOOL_MAX_CONCURRENCY;
    const created = new ConcurrencyLimiter(maxConcurrency, MAX_QUEUE_SIZE, QUEUE_TIMEOUT_MS);
    this.perToolLimiters.set(toolName, created);
    return created;
  }
  public async execute(
    toolName: string,
    tool: ToolRuntimeMetadata,
    args: Record<string, unknown>
  ): Promise<CallToolResult> {
    const requestId = createRequestId();
    const startedAt = Date.now();
    const perToolLimiter = this.getPerToolLimiter(toolName, tool);
    let acquiredGlobal = false;
    let acquiredPerTool = false;
    try {
      logEvent('info', 'tool_execution_started', { requestId, toolName });
      validateToolArguments(toolName, args);
      await this.globalLimiter.acquire();
      acquiredGlobal = true;
      await perToolLimiter.acquire();
      acquiredPerTool = true;
      const requestContext = applyParameterValues(tool, args);
      requestContext.headers['X-Request-Id'] = requestId;
      applyAuthContext(tool, requestContext.headers, requestContext.queryParams);
      applyDefaultAuthHeader(requestContext.headers);
      requestContext.requestData = applyRequestBody(tool, args, requestContext.headers);
      const result = await executeHttpRequest(this.axiosInstance, tool, requestContext, requestId);
      logEvent('info', 'tool_execution_succeeded', { requestId, toolName, durationMs: Date.now() - startedAt });
      return result;
    } catch (error) {
      const toolError = error instanceof ToolExecutionError ? error : mapApiErrorToToolError(error);
      logEvent('error', 'tool_execution_failed', { requestId, toolName, durationMs: Date.now() - startedAt, errorCode: toolError.meta.code, errorSource: toolError.meta.source, retryable: toolError.meta.retryable, httpStatus: toolError.meta.httpStatus });
      return buildToolErrorResult(toolError, requestId);
    } finally {
      if (acquiredPerTool) {
        perToolLimiter.release();
      }
      if (acquiredGlobal) {
        this.globalLimiter.release();
      }
    }
  }
}
