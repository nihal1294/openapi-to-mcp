import { serveStdio, StdioServerTransport } from '@modelcontextprotocol/server/stdio';
import { OpenApiMcpServer } from './server.js';
import * as console from 'console';

console.error("Starting STDIO transport");
// Validate configuration before reporting readiness, then hand this fresh
// server to the SDK's first factory invocation.
let initialServer: OpenApiMcpServer | undefined = new OpenApiMcpServer();
class ReadyStdioTransport extends StdioServerTransport {
  public override async start(): Promise<void> {
    try {
      await super.start();
      console.error("MCP_SERVER_READY");
    } catch (error) {
      console.error('Failed to start STDIO transport:', error);
      process.exit(1);
    }
  }
}
process.stdin.once('end', () => {
  if (initialServer) {
    void initialServer.close();
    initialServer = undefined;
  }
});
serveStdio(() => {
  const instance = initialServer ?? new OpenApiMcpServer();
  initialServer = undefined;
  return instance.server;
}, {
  transport: new ReadyStdioTransport(),
  onerror: (error) => console.error('STDIO transport error:', error),
});
